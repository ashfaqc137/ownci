---
import BaseLayout from '../layouts/BaseLayout.astro'
import { href } from '../lib/paths'
---

<BaseLayout title="Page not found · OwnCI" noindex>
  <main id="main" class="content-page not-found">
    <section class="hero">
      <p class="eyebrow"><span class="eyebrow-dot"></span> 404</p>
      <h1>This job found<br /><span>no matching runner.</span></h1>
      <p class="lead">The page you were looking for doesn’t exist.</p>
      <div class="hero-actions">
        <a class="button-primary" href={href('/')}>Back home <span aria-hidden="true">→</span></a>
        <a class="button-secondary" href={href('/docs/')}>Docs</a>
      </div>
    </section>
  </main>
</BaseLayout>
