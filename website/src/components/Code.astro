---
// Code is passed as a string prop and rendered as escaped text, so `<...>` needs no HTML
// escaping. Pages write snippets as JS template literals, so `${{ ... }}` must be written
// as `\${{ ... }}` there.
interface Props {
  code: string
  label?: string
}

const { code, label } = Astro.props
---

<figure class:list={['code-block', { 'code-block-bare': !label }]}>
  {label && <figcaption>{label}</figcaption>}
  <pre tabindex="0" aria-label={label ? `Code: ${label}` : 'Code'}><code>{code.trim()}</code></pre>
  {/* Hidden until the script below shows it, so a browser without JavaScript or the Clipboard API never sees a dead button. */}
  <button type="button" class="code-copy" hidden aria-label={label ? `Copy code: ${label}` : 'Copy code'}>
    <svg aria-hidden="true" viewBox="0 0 16 16"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" /><path d="M10.5 5.5V3.5A1.5 1.5 0 0 0 9 2H3.5A1.5 1.5 0 0 0 2 3.5V9a1.5 1.5 0 0 0 1.5 1.5h2" /></svg>
    <span aria-live="polite">Copy</span>
  </button>
</figure>

<script>
  // Bundled by Astro into an external file under /_astro/, which the CSP allows as 'self'.
  if (navigator.clipboard) {
    for (const button of document.querySelectorAll<HTMLButtonElement>('.code-copy')) {
      const code = button.parentElement?.querySelector('pre code')
      const status = button.querySelector('span')
      if (!code || !status) continue
      let reset: ReturnType<typeof setTimeout> | undefined
      button.hidden = false
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent ?? '')
          status.textContent = 'Copied'
        } catch {
          status.textContent = 'Press Ctrl+C'
          getSelection()?.selectAllChildren(code)
        }
        clearTimeout(reset)
        reset = setTimeout(() => (status.textContent = 'Copy'), 2000)
      })
    }
  }
</script>
