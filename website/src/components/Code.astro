---
// Code is passed as a string prop and rendered as escaped text, so `<...>` needs no HTML
// escaping. Pages write snippets as JS template literals, so `${{ ... }}` must be written
// as `\${{ ... }}` there.
interface Props {
  code: string
  label?: string
}

const { code, label } = Astro.props
---

<figure class="code-block">
  {label && <figcaption>{label}</figcaption>}
  <pre tabindex="0" aria-label={label ? `Code: ${label}` : 'Code'}><code>{code.trim()}</code></pre>
</figure>
