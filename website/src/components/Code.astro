---
// Code is passed as a string prop and rendered as escaped text, so snippets containing
// `${{ ... }}` or `<...>` need no escaping in the pages that use it.
interface Props {
  code: string
  label?: string
}

const { code, label } = Astro.props
---

<figure class="code-block">
  {label && <figcaption>{label}</figcaption>}
  <pre><code>{code.trim()}</code></pre>
</figure>
