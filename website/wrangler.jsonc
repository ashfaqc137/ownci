{
  "name": "ownci",
  // Fully static site (astro.config.mjs has no server adapter): no `main` worker script,
  // only static assets. public/_headers sets the security headers. See README.md "Deployment".
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
