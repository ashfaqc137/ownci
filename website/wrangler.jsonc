{
  "name": "ownci",
  // Static assets only. Served at sparshlabs.com/ownci/; the pages live in dist/ownci/ so the
  // request path maps straight onto the assets directory.
  "compatibility_date": "2026-10-08",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "sparshlabs.com/ownci*", "zone_name": "sparshlabs.com" }]
}
